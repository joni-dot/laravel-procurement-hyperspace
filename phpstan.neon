includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Setting this replaces Larastan's default, so Core's folder is listed too. Modules keep their
    # tables' migrations next to their code.
    databaseMigrationsPath:
        - database/migrations
        - app/Modules/Srm/Database/Migrations
        - app/Modules/Ppr/Database/Migrations
