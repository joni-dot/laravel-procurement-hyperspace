includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Modules keep their tables' migrations next to their code.
    databaseMigrationsPath:
        - app/Modules/Srm/Database/Migrations
